pkgname=readline
_basever=8.3
_patchlevel=001
pkgver=$_basever.$_patchlevel
pkgrel=1
pkgdesc="GNU readline library"
url="https://tiswww.case.edu/php/chet/readline/rltop.html"
arch="all"
options="!check"
license="GPL-3.0-or-later"
depends="ncurses"
# qnx-io-sock-dev is only needed for header not runtime
makedepends="ncurses-dev qnx-io-sock-dev"
#makedepends_host="chrpath"
subpackages="$pkgname-static $pkgname-dev $pkgname-doc"
source="https://mirror.csclub.uwaterloo.ca/gnu/readline/readline-$_basever.tar.gz
    inputrc
    fix-qnx.patch
"
patch_args="-p0" # patchlevel used by upstream patches

_i=1
while [ $_i -le ${pkgver##*.} ]; do
    _patch=$(printf "%03d" $_i)
    _name=$pkgname${_basever//./}-$_patch
    source="$source
        $_name.patch::https://mirror.csclub.uwaterloo.ca/gnu/readline/readline-$_basever-patches/$_name"
    _i=$((_i+1))
done

builddir="$srcdir/$pkgname-$_basever"

build() {
    ./configure \
        --build=$CBUILD \
        --host=$CHOST \
        --prefix=/usr \
        --mandir=/usr/share/man \
        --enable-static \
        --enable-shared
    make SHLIB_LIBS=-lncurses
}

package() {
    make -C "$builddir" DESTDIR="$pkgdir" install
    install -Dm644 "$srcdir"/inputrc "$pkgdir"/etc/inputrc
}

